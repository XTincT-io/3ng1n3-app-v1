<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.chat.CyberChatActivity">

    <!-- Cyberpunk HUD Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hud_header_background"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cyber_font"
            android:text="@string/chat_header_title"
            android:textColor="@color/neon_green"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/encryption_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/led_board"
            android:text="@string/encryption_status"
            android:textColor="@color/neon_green"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_title" />

        <!-- Network Latency Speedometer -->
        <com.engine.app.ui.components.NetworkSpeedometer
            android:id="@+id/network_speedometer"
            android:layout_width="60dp"
            android:layout_height="40dp"
            app:latency="50"
            app:maxLatency="200"
            app:showDigital="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Encryption RPM Gauge -->
        <com.engine.app.ui.components.EncryptionGauge
            android:id="@+id/encryption_gauge"
            android:layout_width="60dp"
            android:layout_height="40dp"
            app:encryptionLevel="0.5"
            app:layout_constraintEnd_toStartOf="@id/network_speedometer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintTop_toBottomOf="@id/hud_header"
        tools:listitem="@layout/item_message" />

    <!-- Binary Display Panel -->
    <include
        android:id="@+id/binary_display_panel"
        layout="@layout/binary_display_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        tools:visibility="visible" />

    <!-- Message Input Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Message Bubble (for visual effect) -->
        <View
            android:id="@+id/message_bubble"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/message_bubble_background"
            app:layout_constraintBottom_toBottomOf="@id/message_input"
            app:layout_constraintEnd_toStartOf="@id/send_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/message_input" />

        <!-- Message Input Field -->
        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fontFamily="@font/cyber_font"
            android:hint="@string/message_input_hint"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            app:layout_constraintEnd_toStartOf="@id/send_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/send_button_background"
            android:contentDescription="@string/send_message"
            android:src="@drawable/ic_send"
            app:layout_constraintBottom_toBottomOf="@id/message_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/message_input" />

        <!-- Binary Mode Toggle -->
        <ToggleButton
            android:id="@+id/binary_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/toggle_button_background"
            android:textOff="@string/binary_mode_off"
            android:textOn="@string/binary_mode_on"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/message_input"
            android:layout_marginTop="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Radial Control Menu (initially hidden) -->
    <com.engine.app.ui.components.RadialMenu
        android:id="@+id/radial_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:hapticFeedback="true"
        app:itemCount="6"
        app:radiusPercent="0.4"
        app:showLabels="true" />

</androidx.constraintlayout.widget.ConstraintLayout>