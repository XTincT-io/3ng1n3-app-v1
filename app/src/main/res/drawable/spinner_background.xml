<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_darker" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/neon_orange" />
                </shape>
            </item>
            <!-- Dropdown arrow -->
            <item android:right="8dp" android:gravity="center_vertical|right">
                <rotate
                    android:fromDegrees="180"
                    android:toDegrees="180"
                    android:pivotX="50%"
                    android:pivotY="50%">
                    <shape android:shape="triangle">
                        <size android:width="12dp" android:height="6dp" />
                        <solid android:color="@color/neon_orange" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>
    
    <!-- Focused state -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_dark" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/neon_blue" />
                </shape>
            </item>
            <!-- Dropdown arrow -->
            <item android:right="8dp" android:gravity="center_vertical|right">
                <shape android:shape="triangle">
                    <size android:width="12dp" android:height="6dp" />
                    <solid android:color="@color/neon_blue" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_dark" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/neon_orange" />
                </shape>
            </item>
            <!-- Dropdown arrow -->
            <item android:right="8dp" android:gravity="center_vertical|right">
                <shape android:shape="triangle">
                    <size android:width="12dp" android:height="6dp" />
                    <solid android:color="@color/neon_orange" />
                </shape>
            </item>
            <!-- Corner accent -->
            <item
                android:width="8dp"
                android:height="8dp"
                android:gravity="top|left">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neon_orange" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>