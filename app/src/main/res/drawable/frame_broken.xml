<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frame -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="@color/neon_red" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    
    <!-- Broken glass effect - diagonal cracks -->
    <item>
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="line">
                <stroke
                    android:width="1dp"
                    android:color="@color/glitch_white"
                    android:dashWidth="10dp"
                    android:dashGap="5dp" />
            </shape>
        </rotate>
    </item>
    
    <item>
        <rotate
            android:fromDegrees="-30"
            android:pivotX="30%"
            android:pivotY="70%">
            <shape android:shape="line">
                <stroke
                    android:width="1dp"
                    android:color="@color/glitch_white"
                    android:dashWidth="8dp"
                    android:dashGap="4dp" />
            </shape>
        </rotate>
    </item>
    
    <item>
        <rotate
            android:fromDegrees="75"
            android:pivotX="80%"
            android:pivotY="20%">
            <shape android:shape="line">
                <stroke
                    android:width="1dp"
                    android:color="@color/glitch_white"
                    android:dashWidth="12dp"
                    android:dashGap="6dp" />
            </shape>
        </rotate>
    </item>
    
    <!-- Glitch effect patches -->
    <item android:top="30dp" android:bottom="200dp" android:left="20dp" android:right="200dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glitch_red" />
            <size android:height="10dp" />
        </shape>
    </item>
    
    <item android:top="150dp" android:bottom="80dp" android:left="100dp" android:right="50dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glitch_blue" />
            <size android:height="8dp" />
        </shape>
    </item>
    
    <item android:top="200dp" android:bottom="30dp" android:left="50dp" android:right="150dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glitch_green" />
            <size android:height="5dp" />
        </shape>
    </item>
    
    <!-- Static noise overlay -->
    <item>
        <bitmap
            android:src="@drawable/static_noise"
            android:tileMode="repeat"
            android:alpha="0.15" />
    </item>
    
    <!-- Broken corner -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="top|right">
        <rotate
            android:fromDegrees="45"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="@color/cyberpunk_background_darkest" />
            </shape>
        </rotate>
    </item>
</layer-list>