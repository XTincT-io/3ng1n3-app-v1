<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="4dp"
                android:color="@color/neon_blue" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Inner stroke -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/neon_cyan" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    
    <!-- Corner accents - top left -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="top|left">
        <rotate
            android:fromDegrees="0"
            android:pivotX="0%"
            android:pivotY="0%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="top|left">
        <rotate
            android:fromDegrees="90"
            android:pivotX="0%"
            android:pivotY="0%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <!-- Corner accents - top right -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="top|right">
        <rotate
            android:fromDegrees="0"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="top|right">
        <rotate
            android:fromDegrees="-90"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <!-- Corner accents - bottom left -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="bottom|left">
        <rotate
            android:fromDegrees="-90"
            android:pivotX="0%"
            android:pivotY="100%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="bottom|left">
        <rotate
            android:fromDegrees="0"
            android:pivotX="0%"
            android:pivotY="100%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <!-- Corner accents - bottom right -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="bottom|right">
        <rotate
            android:fromDegrees="90"
            android:pivotX="100%"
            android:pivotY="100%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
    
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="bottom|right">
        <rotate
            android:fromDegrees="0"
            android:pivotX="100%"
            android:pivotY="100%">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="@color/neon_green" />
            </shape>
        </rotate>
    </item>
</layer-list>