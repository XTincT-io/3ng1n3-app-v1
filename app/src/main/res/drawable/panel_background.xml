<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background with gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/cyberpunk_background_darker"
                android:endColor="@color/cyberpunk_background_darkest" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Grid overlay -->
    <item>
        <bitmap
            android:src="@drawable/grid_pattern"
            android:tileMode="repeat"
            android:alpha="0.1" />
    </item>
    
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/neon_orange" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Corner accents - top left -->
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="top|left">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_orange" />
            <corners
                android:topLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>
    
    <!-- Corner accents - bottom right -->
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="bottom|right">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_orange" />
            <corners
                android:topLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>
</layer-list>