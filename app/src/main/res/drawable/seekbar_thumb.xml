<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <solid android:color="#4000FFFF" />
        </shape>
    </item>
    
    <!-- Main thumb -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <size android:width="16dp" android:height="16dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="8dp"
                android:startColor="@color/neon_cyan"
                android:endColor="@color/neon_blue" />
            <stroke
                android:width="1dp"
                android:color="@color/neon_green" />
        </shape>
    </item>
    
    <!-- Center dot -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <size android:width="4dp" android:height="4dp" />
            <solid android:color="@color/cyberpunk_background_darkest" />
        </shape>
    </item>
</layer-list>