<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_darker" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/neon_green_dim" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_darkest" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Focused state -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_dark" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/neon_blue" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_darker" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_dark" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/neon_green" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cyberpunk_background_darker" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <!-- Corner accents - top left -->
            <item
                android:width="8dp"
                android:height="8dp"
                android:gravity="top|left">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neon_green" />
                </shape>
            </item>
            <!-- Corner accents - bottom right -->
            <item
                android:width="8dp"
                android:height="8dp"
                android:gravity="bottom|right">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neon_green" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>