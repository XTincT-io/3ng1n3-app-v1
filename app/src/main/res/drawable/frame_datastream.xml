<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frame -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/neon_purple" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Data stream lines - horizontal -->
    <item android:top="10dp" android:bottom="230dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:height="1dp" />
        </shape>
    </item>
    
    <item android:top="20dp" android:bottom="220dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:height="1dp" />
        </shape>
    </item>
    
    <item android:top="230dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:height="1dp" />
        </shape>
    </item>
    
    <item android:top="240dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:height="1dp" />
        </shape>
    </item>
    
    <!-- Data stream lines - vertical -->
    <item android:left="10dp" android:right="230dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:width="1dp" />
        </shape>
    </item>
    
    <item android:left="20dp" android:right="220dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:width="1dp" />
        </shape>
    </item>
    
    <item android:left="230dp" android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:width="1dp" />
        </shape>
    </item>
    
    <item android:left="240dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_purple" />
            <size android:width="1dp" />
        </shape>
    </item>
    
    <!-- Binary data overlay -->
    <item>
        <bitmap
            android:src="@drawable/binary_pattern"
            android:tileMode="repeat"
            android:alpha="0.2" />
    </item>
    
    <!-- Waveform visualization -->
    <item android:top="100dp" android:bottom="100dp">
        <bitmap
            android:src="@drawable/waveform_pattern"
            android:tileMode="repeat"
            android:alpha="0.7" />
    </item>
    
    <!-- Corner data nodes -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="top|left">
        <shape android:shape="oval">
            <solid android:color="@color/neon_purple" />
        </shape>
    </item>
    
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="top|right">
        <shape android:shape="oval">
            <solid android:color="@color/neon_purple" />
        </shape>
    </item>
    
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="bottom|left">
        <shape android:shape="oval">
            <solid android:color="@color/neon_purple" />
        </shape>
    </item>
    
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="bottom|right">
        <shape android:shape="oval">
            <solid android:color="@color/neon_purple" />
        </shape>
    </item>
</layer-list>